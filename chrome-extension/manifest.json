{
  "manifest_version": 3,
  "name": "CustomLobbies.com - Screen Capture & Queue Assistant",
  "version": "1.0.0",
  "description": "Stream gameplay, trigger follower alerts, inject stream overlay HUD, and join custom lobbies directly from your browser toolbar.",
  "permissions": [
    "desktopCapture",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://customlobbies.com/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
