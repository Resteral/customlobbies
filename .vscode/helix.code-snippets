{
  "Helix Item (Consumable)": {
    "prefix": "ixitem:consumable",
    "body": [
      "ITEM.name = \"${1:Item Name}\"",
      "ITEM.description = \"${2:Item Description}\"",
      "ITEM.model = \"${3:models/props_junk/garbage_plasticbottle003a.mdl}\"",
      "ITEM.width = ${4:1}",
      "ITEM.height = ${5:1}",
      "ITEM.category = \"${6:Consumables}\"",
      "ITEM.price = ${7:50}",
      "",
      "ITEM.functions.Consume = {",
      "\tname = \"${8:Consume}\",",
      "\ttip = \"useTip\",",
      "\ticon = \"icon16/cup.png\",",
      "\tOnRun = function(item)",
      "\t\tlocal client = item.player",
      "\t\tlocal char = client:GetCharacter()",
      "\t\tif not char then return false end",
      "\t\t",
      "\t\tclient:SetHealth(math.min(client:GetMaxHealth(), client:Health() + ${9:25}))",
      "\t\tclient:EmitSound(\"npc/barnacle/barnacle_gulp${10|1,2|}.wav\")",
      "\t\tclient:Notify(\"You consumed \" .. item.name .. \".\")",
      "\t\treturn true",
      "\tend",
      "}"
    ],
    "description": "Scaffold a consumable Helix item (drinks, food, meds)"
  },
  "Helix Item (Equippable Weapon / Gear)": {
    "prefix": "ixitem:equip",
    "body": [
      "ITEM.name = \"${1:Item Name}\"",
      "ITEM.description = \"${2:Item Description}\"",
      "ITEM.model = \"${3:models/weapons/w_pist_glock18.mdl}\"",
      "ITEM.class = \"${4:weapon_glock}\"",
      "ITEM.width = ${5:2}",
      "ITEM.height = ${6:1}",
      "ITEM.isWeapon = true",
      "ITEM.category = \"${7:Weapons}\"",
      "ITEM.price = ${8:500}",
      "",
      "ITEM.functions.Equip = {",
      "\tname = \"Equip\",",
      "\ttip = \"equipTip\",",
      "\ticon = \"icon16/tick.png\",",
      "\tOnRun = function(item)",
      "\t\tlocal client = item.player",
      "\t\tif client:HasWeapon(item.class) then",
      "\t\t\tclient:Notify(\"You already have this equipped!\")",
      "\t\t\treturn false",
      "\t\tend",
      "\t\tclient:Give(item.class)",
      "\t\tclient:SelectWeapon(item.class)",
      "\t\treturn true",
      "\tend",
      "}"
    ],
    "description": "Scaffold an equippable weapon/gear Helix item"
  },
  "Helix Crafting Recipe": {
    "prefix": "ixrecipe",
    "body": [
      "[\"${1:recipe_id}\"] = {",
      "\tname = \"${2:Recipe Name}\",",
      "\tdesc = \"${3:Description of crafted item.}\",",
      "\tcategory = \"${4:General}\",",
      "\tresult = \"${5:result_item_id}\",",
      "\tamount = ${6:1},",
      "\tcraftTime = ${7:5},",
      "\treqSkills = { ${8:crafting} = ${9:1} },",
      "\tingredients = {",
      "\t\t[\"${10:scrap_metal}\"] = ${11:2}",
      "\t},",
      "\txp = { skill = \"${8:crafting}\", amount = ${12:30} }",
      "}"
    ],
    "description": "Scaffold a Helix PERP crafting recipe definition"
  },
  "Helix Command": {
    "prefix": "ixcmd",
    "body": [
      "ix.command.Add(\"${1:CommandName}\", {",
      "\tdescription = \"${2:Description of command.}\",",
      "\tadminOnly = ${3:false},",
      "\targuments = {",
      "\t\tix.type.player,",
      "\t\tix.type.string",
      "\t},",
      "\tOnRun = function(self, client, target, reason)",
      "\t\tlocal char = target:GetCharacter()",
      "\t\tif not char then return \"@invalidChar\" end",
      "\t\t",
      "\t\t$0",
      "\t\treturn \"Command executed successfully.\"",
      "\tend",
      "})"
    ],
    "description": "Scaffold a new Helix chat/console command"
  },
  "Helix Plugin Scaffold": {
    "prefix": "ixplugin",
    "body": [
      "local PLUGIN = PLUGIN or {}",
      "PLUGIN.name = \"${1:Plugin Name}\"",
      "PLUGIN.author = \"${2:Author}\"",
      "PLUGIN.description = \"${3:Plugin description.}\"",
      "",
      "ix.util.Include(\"sh_plugin.lua\")",
      "ix.util.Include(\"sv_plugin.lua\")",
      "ix.util.Include(\"cl_plugin.lua\")",
      "",
      "function PLUGIN:InitializedPlugins()",
      "\t$0",
      "end"
    ],
    "description": "Scaffold Helix Plugin header"
  },
  "Helix Custom Entity": {
    "prefix": "ixentity",
    "body": [
      "AddCSLuaFile()",
      "",
      "ENT.Type = \"anim\"",
      "ENT.Base = \"base_gmodentity\"",
      "ENT.PrintName = \"${1:Entity Name}\"",
      "ENT.Author = \"${2:Author}\"",
      "ENT.Spawnable = true",
      "ENT.Category = \"Helix\"",
      "",
      "function ENT:SetupDataTables()",
      "\tself:NetworkVar(\"String\", 0, \"StationType\")",
      "end",
      "",
      "if SERVER then",
      "\tfunction ENT:Initialize()",
      "\t\tself:SetModel(\"${3:models/props_c17/furnituretable002a.mdl}\")",
      "\t\tself:PhysicsInit(SOLID_VPHYSICS)",
      "\t\tself:SetMoveType(MOVETYPE_VPHYSICS)",
      "\t\tself:SetSolid(SOLID_VPHYSICS)",
      "\t\tself:SetUseType(SIMPLE_USE)",
      "\t\t",
      "\t\tlocal phys = self:GetPhysicsObject()",
      "\t\tif IsValid(phys) then",
      "\t\t\tphys:Wake()",
      "\t\tend",
      "\tend",
      "\t",
      "\tfunction ENT:Use(activator, caller)",
      "\t\tif not IsValid(activator) or not activator:IsPlayer() then return end",
      "\t\t$0",
      "\tend",
      "else",
      "\tfunction ENT:Draw()",
      "\t\tself:DrawModel()",
      "\tend",
      "end"
    ],
    "description": "Scaffold a complete Helix interactive networked entity"
  },
  "Helix Derma Frame Panel": {
    "prefix": "ixderma",
    "body": [
      "local PANEL = {}",
      "",
      "function PANEL:Init()",
      "\tself:SetSize(ScrW() * 0.45, ScrH() * 0.55)",
      "\tself:Center()",
      "\tself:MakePopup()",
      "\tself:SetTitle(\"${1:Window Title}\")",
      "\t",
      "\tself.scroll = vgui.Create(\"DScrollPanel\", self)",
      "\tself.scroll:Dock(FILL)",
      "\tself.scroll:DockMargin(10, 10, 10, 10)",
      "\t",
      "\t$0",
      "end",
      "",
      "function PANEL:Paint(w, h)",
      "\tdraw.RoundedBox(8, 0, 0, w, h, Color(24, 28, 36, 240))",
      "\tdraw.RoundedBoxEx(8, 0, 0, w, 32, Color(16, 18, 24, 255), true, true, false, false)",
      "end",
      "",
      "vgui.Register(\"${2:ixCustomMenu}\", PANEL, \"DFrame\")"
    ],
    "description": "Scaffold a custom stylized Helix Derma VGUI menu"
  },
  "Helix Net Receiver & Sender": {
    "prefix": "ixnet",
    "body": [
      "if SERVER then",
      "\tutil.AddNetworkString(\"ix${1:MessageName}\")",
      "\t",
      "\tnet.Receive(\"ix${1:MessageName}\", function(len, client)",
      "\t\tif not IsValid(client) then return end",
      "\t\tlocal data = net.ReadTable()",
      "\t\t$0",
      "\tend)",
      "else",
      "\tfunction ix.Send${1:MessageName}(data)",
      "\t\tnet.Start(\"ix${1:MessageName}\")",
      "\t\tnet.WriteTable(data or {})",
      "\t\tnet.SendToServer()",
      "\tend",
      "end"
    ],
    "description": "Scaffold an optimized Helix networked receiver and sender pair"
  }
}
